function Icon({ name, size = 18, stroke = 1.8 }: { name: string; size?: number; stroke?: number }) {
  return <svg aria-hidden="true" className="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={stroke} strokeLinecap="round" strokeLinejoin="round"><path d={iconPaths[name] ?? iconPaths.sparkle} /></svg>
}

function Logo({ compact = false }: { compact?: boolean }) {
  return <div className={`brand-lockup ${compact ? 'brand-lockup--compact' : ''}`} aria-label="Little Star Playhouse">
    <img className="brand-logo-image" src="/assets/little-star-playhouse-logo.png" alt="Little Star Playhouse — A safe place for little stars to shine." />
  </div>
}

function Toast({ message, onClose }: { message: string; onClose: () => void }) {
  return <div className="toast" role="status"><Icon name="check" size={17} /><span>{message}</span><button aria-label="Close notification" onClick={onClose}><Icon name="close" size={15} /></button></div>
}

function SiteHeader({ lang, setLang, onNavigate }: { lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) {
  const [open, setOpen] = useState(false)
  const t = translations[lang]
  const navItems = [['/', t.nav.home], ['/about', t.nav.about], ['/programs', t.nav.programs], ['/our-little-world', t.nav.world], ['/gallery', t.nav.gallery], ['/notices', t.nav.notices], ['/documents', t.nav.documents]]
  const go = (path: string) => { setOpen(false); onNavigate(path) }
  return <>
    <div className="announcement"><span><Icon name="sparkle" size={14} /> A little world of learning is waiting in Janakpurdham.</span><button onClick={() => go('/contact')}>Visit us <Icon name="arrow" size={14} /></button></div>
    <header className="site-header">
      <div className="shell header-inner"><button className="logo-button" onClick={() => go('/')}><Logo /></button><nav className={`site-nav ${open ? 'site-nav--open' : ''}`}>{navItems.map(([path, label]) => <button key={path} className={window.location.pathname === path ? 'is-active' : ''} onClick={() => go(path)}>{label}</button>)}<div className="nav-mobile-actions"><button className="lang-switch" onClick={() => setLang(lang === 'en' ? 'ne' : 'en')}><span className={lang === 'en' ? 'active' : ''}>EN</span><span>/</span><span className={lang === 'ne' ? 'active' : ''}>ने</span></button><a className="button button--small header-enquire" href="/contact" onClick={event => { event.preventDefault(); go('/contact') }}>{t.actions.headerEnquire} <Icon name="arrow" size={15} /></a></div></nav><div className="header-actions"><button className="lang-switch" onClick={() => setLang(lang === 'en' ? 'ne' : 'en')}><span className={lang === 'en' ? 'active' : ''}>EN</span><span>/</span><span className={lang === 'ne' ? 'active' : ''}>ने</span></button><a className="button button--small header-enquire" href="/contact" onClick={event => { event.preventDefault(); go('/contact') }}>{t.actions.headerEnquire} <Icon name="arrow" size={15} /></a><button className="menu-button" aria-label="Open menu" aria-expanded={open} onClick={() => setOpen(!open)}><Icon name={open ? 'close' : 'menu'} size={22} /></button></div></div>
    </header>
  </>
}

function Footer({ lang, onNavigate }: { lang: Lang; onNavigate: (path: string) => void }) {
  const t = translations[lang]
  return <footer className="site-footer"><div className="shell footer-grid"><div><button className="footer-logo" onClick={() => onNavigate('/')}><Logo /></button><p>A caring, joyful place where little learners explore, discover confidence, and grow through play.</p><div className="footer-socials"><a href="https://wa.me/9779709142797" aria-label="WhatsApp"><span>WA</span></a><a href="mailto:littlestarplayhouse2026@gmail.com" aria-label="Email"><Icon name="mail" size={17} /></a><a href="tel:+9779709142797" aria-label="Call"><Icon name="phone" size={17} /></a></div></div><div><h4>Explore</h4><button onClick={() => onNavigate('/about')}>{t.nav.about}</button><button onClick={() => onNavigate('/programs')}>{t.nav.programs}</button><button onClick={() => onNavigate('/our-little-world')}>{t.nav.world}</button><button onClick={() => onNavigate('/notices')}>{t.nav.notices}</button></div><div><h4>Parent shelf</h4><button onClick={() => onNavigate('/documents')}>{t.nav.documents}</button><button onClick={() => onNavigate('/contact')}>{t.actions.enquire}</button><button onClick={() => window.open(MAPS_URL, '_blank')}>{t.actions.directions}</button><button onClick={() => onNavigate('/admin')}>{t.nav.admin}</button></div><div><h4>Come say hello</h4><p className="footer-address">Ward 4, Janakpurdham,<br />Dhanusha, Nepal<br /><span>Near the old Sanchaykosh Office, on the way to Kataiyachauri.</span></p><a href="tel:+9779709142797">9709142797</a><a href="mailto:littlestarplayhouse2026@gmail.com">littlestarplayhouse2026@gmail.com</a></div></div><div className="shell footer-bottom"><span>© 2026 Little Star Playhouse</span><span>A safe place for little stars to shine.</span></div></footer>
}

function PublicShell({ children, lang, setLang, onNavigate }: { children: ReactNode; lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) {
  return <><SiteHeader lang={lang} setLang={setLang} onNavigate={onNavigate} />{children}<Footer lang={lang} onNavigate={onNavigate} /></>
}

function SectionLabel({ children, tone = 'blue' }: { children: ReactNode; tone?: string }) { return <span className={`section-label section-label--${tone}`}><i />{children}</span> }
function PageIntro({ eyebrow, title, text, tone = 'blue' }: { eyebrow: string; title: string; text: string; tone?: string }) { return <section className={`page-intro page-intro--${tone}`}><div className="shell page-intro-inner"><div><SectionLabel tone={tone}>{eyebrow}</SectionLabel><h1>{title}</h1><p>{text}</p></div><div className="intro-orbit"><span className="orbit-star"><Icon name="star" size={30} /></span><span className="orbit-cloud" /><span className="orbit-dot orbit-dot--one" /><span className="orbit-dot orbit-dot--two" /></div></div></section> }
function Button({ children, onClick, variant = 'primary', type = 'button', disabled = false }: { children: ReactNode; onClick?: () => void; variant?: 'primary' | 'outline' | 'soft' | 'text' | 'danger'; type?: 'button' | 'submit'; disabled?: boolean }) { return <button type={type} disabled={disabled} className={`button button--${variant}`} onClick={onClick}>{children}</button> }

function Hero({ lang, onNavigate }: { lang: Lang; onNavigate: (path: string) => void }) {
  const t = translations[lang]
  return <section className="hero"><div className="hero-cloud hero-cloud--one" /><div className="hero-cloud hero-cloud--two" /><div className="shell hero-grid"><div className="hero-copy"><SectionLabel tone="yellow">Little Star Playhouse · Janakpurdham</SectionLabel><h1>Big dreams begin with <span>little steps!</span></h1><p>A caring, joyful place where little learners explore, discover their confidence, and grow through play.</p><div className="hero-actions"><Button onClick={() => onNavigate('/contact')}>{t.actions.enquire} <Icon name="arrow" size={17} /></Button><Button variant="outline" onClick={() => onNavigate('/our-little-world')}><span className="play-dot"><Icon name="play" size={12} /></span>{t.actions.discover}</Button></div><div className="hero-note"><span className="avatar-stack"><i>✦</i><i>♡</i><i>●</i></span><span>Warm beginnings. Curious minds. Room to grow.</span></div></div><div className="hero-art"><div className="hero-art-frame"><img src={HERO_ART} alt="Children building and painting in a full Little Star Playhouse classroom scene" loading="eager" fetchPriority="high" decoding="async" /><div className="hero-sticker hero-sticker--top"><Icon name="star" size={17} /> play, learn, shine</div><div className="hero-sticker hero-sticker--bottom"><span className="sticker-dot" /> A happy little world</div></div></div></div><div className="hero-wave" /></section>
}

function TrustStrip() { const items = [{ icon: 'heart', title: 'Early childhood learning', text: 'Gentle foundations' }, { icon: 'play', title: 'Learning through play', text: 'Curiosity leads the way' }, { icon: 'brush', title: 'Creative exploration', text: 'Make room for wonder' }, { icon: 'star', title: 'A welcoming environment', text: 'Every little star belongs' }]; return <section className="trust-strip"><div className="shell trust-grid">{items.map(item => <div className="trust-item" key={item.title}><span className="trust-icon"><Icon name={item.icon} size={22} /></span><div><strong>{item.title}</strong><small>{item.text}</small></div></div>)}</div></section> }

function HomePage({ lang, setLang, onNavigate }: { lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) {
  return <PublicShell lang={lang} setLang={setLang} onNavigate={onNavigate}><Hero lang={lang} onNavigate={onNavigate} /><TrustStrip /><section className="section about-home"><div className="shell split-grid"><div className="photo-card photo-card--tall"><img src={GALLERY_ART} alt="Children exploring blocks and art materials in a warm classroom" loading="lazy" /><span className="photo-note"><Icon name="sparkle" size={15} /> little moments, big meaning</span></div><div className="section-copy"><SectionLabel tone="green">A place to grow into</SectionLabel><h2>Little steps.<br /><span>Big discoveries.</span></h2><p>Little Star Playhouse is a caring space for young learners to feel safe, seen, and excited about the world around them. We make space for stories, messy making, music, movement, and the small moments that build confidence.</p><p>Our days are shaped by warm relationships and playful invitations, so every child can find their own way to join in.</p><Button variant="text" onClick={() => onNavigate('/about')}>Meet our playhouse <Icon name="arrow" size={16} /></Button><div className="margin-note"><span>01</span><p>“A safe place for little stars to shine.”</p></div></div></div></section><ProgramsPreview lang={lang} onNavigate={onNavigate} /><WorldPreview onNavigate={onNavigate} /><GalleryPreview /><AdmissionCTA lang={lang} onNavigate={onNavigate} /><FAQPreview /><ContactPreview lang={lang} onNavigate={onNavigate} /></PublicShell>
}

function ProgramsPreview({ lang, onNavigate }: { lang: Lang; onNavigate: (path: string) => void }) { const t = translations[lang]; return <section className="section section--pale-blue"><div className="shell"><div className="section-heading-row"><div><SectionLabel tone="blue">Find your little rhythm</SectionLabel><h2>Programs made for <span>curious beginnings.</span></h2></div><Button variant="text" onClick={() => onNavigate('/programs')}>{t.actions.explore} <Icon name="arrow" size={16} /></Button></div><div className="program-grid">{programs.map((program, index) => <article className={`program-card program-card--${program.color}`} key={program.title}><div className="program-art"><img src={program.image} alt={`${program.title} activity`} loading="lazy" /><span className="program-art-overlay" /><span className="program-icon"><Icon name={program.icon} size={25} /></span><span className="program-number">0{index + 1}</span><div className="program-shape program-shape--one" /><div className="program-shape program-shape--two" /></div><div className="program-content"><span className="program-age">{program.age}</span><h3>{program.title}</h3><p>{program.text}</p><button onClick={() => onNavigate('/programs')}>Explore program <Icon name="arrow" size={15} /></button></div></article>)}</div></div></section> }
function WorldPreview({ onNavigate }: { onNavigate: (path: string) => void }) { return <section className="section world-preview"><div className="shell"><div className="section-heading-row"><div><SectionLabel tone="yellow">Come play with us</SectionLabel><h2>Our little world is full of <span>bright ideas.</span></h2></div><Button variant="text" onClick={() => onNavigate('/our-little-world')}>See all activities <Icon name="arrow" size={16} /></Button></div><div className="activity-mosaic">{activities.map(item => <article className={`activity-card activity-card--${item.color} ${item.wide ? 'activity-card--wide' : ''}`} key={item.title}><span className="activity-icon"><Icon name={item.icon} size={23} /></span><div><h3>{item.title}</h3><p>{item.text}</p></div><span className="activity-arrow"><Icon name="arrow" size={16} /></span></article>)}</div></div></section> }
function GalleryPreview() { const [lightbox, setLightbox] = useState(false); return <section className="section gallery-section"><div className="shell"><div className="section-heading-row"><div><SectionLabel tone="coral">A peek inside</SectionLabel><h2>Little moments from <span>our happy days.</span></h2></div><span className="gallery-caption"><Icon name="image" size={16} /> Replaceable image previews</span></div><div className="gallery-grid"><div className="gallery-tile gallery-tile--large gallery-tile-button" role="button" tabIndex={0} onClick={() => setLightbox(true)} onKeyDown={event => { if (event.key === 'Enter' || event.key === ' ') setLightbox(true) }} aria-label="Open classroom image preview"><img src={GALLERY_ART} alt="Children creating with blocks and art supplies" loading="lazy" /><span>Building and discovery · View larger</span></div><div className="gallery-tile gallery-tile--yellow"><span className="gallery-doodle"><Icon name="star" size={35} /></span><strong>Make<br />room for<br /><em>wonder.</em></strong></div><div className="gallery-tile gallery-tile--blue"><span className="gallery-doodle"><Icon name="music" size={32} /></span><strong>Sing it,<br />move it,<br /><em>feel it.</em></strong></div></div></div>{lightbox && <div className="lightbox" role="dialog" aria-modal="true" aria-label="Classroom image preview" onClick={() => setLightbox(false)}><div className="lightbox-card" onClick={event => event.stopPropagation()}><button className="lightbox-close" aria-label="Close image preview" onClick={() => setLightbox(false)}><Icon name="close" size={20} /></button><img src={GALLERY_ART} alt="Children creating with blocks and art supplies" /><p>Building and discovery · image preview</p></div></div>}</section> }
function AdmissionCTA({ lang, onNavigate }: { lang: Lang; onNavigate: (path: string) => void }) { const t = translations[lang]; return <section className="admission-section"><div className="shell admission-card"><div className="admission-stars"><Icon name="star" size={22} /><Icon name="star" size={13} /><Icon name="star" size={17} /></div><div><SectionLabel tone="yellow">A happy next chapter</SectionLabel><h2>Your child’s next happy chapter <span>starts here!</span></h2><p>Have a question, a little one ready to explore, or simply want to say hello? We would love to hear from you.</p></div><div className="admission-actions"><Button onClick={() => window.open('https://wa.me/9779709142797', '_blank')}>{t.actions.whatsapp} <Icon name="arrow" size={16} /></Button><Button variant="outline" onClick={() => onNavigate('/contact')}>{t.actions.call} <Icon name="phone" size={16} /></Button></div></div></section> }
function FAQPreview() { const [open, setOpen] = useState(0); return <section className="section faq-section"><div className="shell split-grid split-grid--faq"><div className="section-copy"><SectionLabel tone="blue">The little things</SectionLabel><h2>Questions are <span>welcome here.</span></h2><p>Starting something new can bring a lot of questions. Here are a few gentle answers to get you started.</p><div className="faq-badge"><Icon name="sparkle" size={19} /><span>Still curious?</span><a href="mailto:littlestarplayhouse2026@gmail.com">Ask us anything <Icon name="arrow" size={14} /></a></div></div><div className="faq-list">{faq.map((item, index) => <div className={`faq-item ${open === index ? 'is-open' : ''}`} key={item.q}><button onClick={() => setOpen(open === index ? -1 : index)} aria-expanded={open === index}><span>{item.q}</span><span className="faq-plus"><Icon name={open === index ? 'close' : 'plus'} size={17} /></span></button>{open === index && <p>{item.a}</p>}</div>)}</div></div></section> }
function ContactPreview({ lang, onNavigate }: { lang: Lang; onNavigate: (path: string) => void }) { const t = translations[lang]; return <section className="contact-preview"><div className="shell contact-preview-inner"><div><SectionLabel tone="yellow">Come say hello</SectionLabel><h2>We’re right here in <span>Janakpurdham.</span></h2><p>Ward 4, Dhanusha, Nepal<br />Near the old Sanchaykosh Office, on the way to Kataiyachauri.</p></div><div className="contact-actions"><a href="tel:+9779709142797"><Icon name="phone" size={18} />9709142797</a><a href="mailto:littlestarplayhouse2026@gmail.com"><Icon name="mail" size={18} />Email the playhouse</a><Button variant="outline" onClick={() => window.open(MAPS_URL, '_blank')}>{t.actions.directions} <Icon name="arrow" size={16} /></Button></div></div></section> }

function AboutPage({ lang, setLang, onNavigate }: { lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) { return <PublicShell lang={lang} setLang={setLang} onNavigate={onNavigate}><PageIntro eyebrow="The heart of the playhouse" title="A safe place for little stars to shine." text="We believe the early years deserve patience, wonder, and lots of room to become." tone="green" /><section className="section"><div className="shell split-grid"><div className="section-copy"><SectionLabel tone="green">Our philosophy</SectionLabel><h2>Childhood is not a race. <span>It is a world.</span></h2><p>At Little Star Playhouse, learning begins with belonging. Our environment is designed to help children feel safe enough to wonder, brave enough to try, and supported enough to keep going.</p><p>We use play, conversation, movement, making, and warm relationships as invitations into learning. The details are little, but the discoveries are big.</p><div className="values-row"><div><strong>01</strong><span>Warm relationships</span></div><div><strong>02</strong><span>Playful learning</span></div><div><strong>03</strong><span>Growing confidence</span></div></div></div><div className="story-card story-card--green"><div className="story-card-star"><Icon name="star" size={32} /></div><h3>Little Star<br /><span>promise</span></h3><p>Every child deserves a place where their questions are welcome and their small steps are celebrated.</p><div className="story-card-line" /></div></div></section><AdmissionCTA lang="en" onNavigate={onNavigate} /></PublicShell> }
function ProgramsPage({ lang, setLang, onNavigate }: { lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) { return <PublicShell lang={lang} setLang={setLang} onNavigate={onNavigate}><PageIntro eyebrow="Find your little rhythm" title="Programs that grow with curiosity." text="Every program is an invitation: to play, to make, to move, and to discover what comes next." tone="blue" /><section className="section section--pale-yellow"><div className="shell program-grid program-grid--page">{programs.map((program, index) => <article className={`program-card program-card--${program.color}`} key={program.title}><div className="program-art"><img src={program.image} alt={`${program.title} activity`} loading="lazy" /><span className="program-art-overlay" /><span className="program-icon"><Icon name={program.icon} size={25} /></span><span className="program-number">0{index + 1}</span><div className="program-shape program-shape--one" /><div className="program-shape program-shape--two" /></div><div className="program-content"><span className="program-age">{program.age}</span><h3>{program.title}</h3><p>{program.text}</p><ul><li><Icon name="check" size={15} />Stories and shared conversation</li><li><Icon name="check" size={15} />Hands-on creative invitations</li><li><Icon name="check" size={15} />Gentle routines that build confidence</li></ul><Button variant="text" onClick={() => onNavigate('/contact')}>Ask about this program <Icon name="arrow" size={15} /></Button></div></article>)}</div></section><AdmissionCTA lang="en" onNavigate={onNavigate} /></PublicShell> }
function WorldPage({ lang, setLang, onNavigate }: { lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) { return <PublicShell lang={lang} setLang={setLang} onNavigate={onNavigate}><PageIntro eyebrow="Come play with us" title="Our little world is full of bright ideas." text="A playful day can hold a story, a song, a tower, a paintbrush, and a hundred ways to wonder." tone="yellow" /><section className="section"><div className="shell activity-mosaic activity-mosaic--page">{activities.map(item => <article className={`activity-card activity-card--${item.color} ${item.wide ? 'activity-card--wide' : ''}`} key={item.title}><span className="activity-icon"><Icon name={item.icon} size={25} /></span><div><h3>{item.title}</h3><p>{item.text}</p><p className="activity-long">We make space for children to follow their interests, share ideas, and find their own way into the invitation.</p></div><span className="activity-arrow"><Icon name="arrow" size={17} /></span></article>)}</div></section><GalleryPreview /></PublicShell> }
function ContactPage({ lang, setLang, onNavigate }: { lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) { return <PublicShell lang={lang} setLang={setLang} onNavigate={onNavigate}><PageIntro eyebrow="We’d love to hear from you" title="Come say hello to the playhouse." text="Questions, directions, admission enquiries, or a simple hello — there is always room for a good conversation." tone="coral" /><section className="section"><div className="shell contact-page-grid"><div className="contact-detail-card"><SectionLabel tone="blue">Find us here</SectionLabel><h2>Little Star<br /><span>Playhouse</span></h2><p>Ward 4, Janakpurdham, Dhanusha, Nepal</p><p className="muted">Near the old Sanchaykosh Office, on the way to Kataiyachauri.</p><div className="contact-detail-list"><a href="tel:+9779709142797"><span><Icon name="phone" size={19} /></span><div><small>Phone</small><strong>9709142797</strong></div></a><a href="mailto:littlestarplayhouse2026@gmail.com"><span><Icon name="mail" size={19} /></span><div><small>Email</small><strong>littlestarplayhouse2026@gmail.com</strong></div></a></div><div className="contact-detail-actions"><Button onClick={() => window.open('https://wa.me/9779709142797', '_blank')}>WhatsApp <Icon name="arrow" size={15} /></Button><Button variant="outline" onClick={() => window.open(MAPS_URL, '_blank')}>Get directions <Icon name="pin" size={16} /></Button></div></div><div className="enquiry-card"><SectionLabel tone="yellow">Start a conversation</SectionLabel><h2>Tell us a little <span>about your question.</span></h2><form onSubmit={event => { event.preventDefault(); alert('Prototype enquiry received — in Phase 2 this form can connect to the school inbox.') }}><label>Your name<input required placeholder="A parent or carer name" /></label><label>Your email<input required type="email" placeholder="you@example.com" /></label><label>What can we help with?<textarea required rows={4} placeholder="I would love to ask about…" /></label><Button type="submit">Send enquiry <Icon name="arrow" size={16} /></Button><small className="form-note">This is a frontend prototype. No message is sent yet.</small></form></div></div></section></PublicShell> }

function FilterBar({ value, setValue, categories, placeholder }: { value: string; setValue: (value: string) => void; categories: string[]; placeholder: string }) { return <div className="filter-bar"><div className="search-field"><Icon name="search" size={18} /><input value={value} onChange={event => setValue(event.target.value)} placeholder={placeholder} aria-label={placeholder} /></div><div className="filter-chips">{categories.map(category => <button className={value === category ? 'is-selected' : ''} key={category} onClick={() => setValue(value === category ? '' : category)}><Icon name={category === 'All' ? 'sparkle' : 'filter'} size={14} />{category}</button>)}</div></div> }
function NoticeCard({ notice, onNavigate }: { notice: Notice; onNavigate: (path: string) => void }) { return <article className="notice-card"><div className="notice-card-head"><div className="mini-brand"><span><Icon name="star" size={15} /></span><div><strong>Little Star Playhouse</strong><small>Development preview · {notice.date}</small></div></div><button className="more-button" aria-label="More notice actions" onClick={() => onNavigate(`/notices/${notice.id}`)}>•••</button></div>{notice.cover && <div className="notice-cover"><img src={notice.cover} alt="" loading="lazy" /><div className="notice-cover-badge"><Icon name={notice.category === 'Events' ? 'calendar' : 'bell'} size={14} /> {notice.category}</div></div>}<div className="notice-card-body"><div className="notice-tags"><span className={`tag tag--${notice.important ? 'important' : 'blue'}`}>{notice.important && <Icon name="star" size={12} />}{notice.category}</span>{notice.pinned && <span className="tag tag--outline"><Icon name="pin" size={12} /> Pinned</span>}</div><h2>{notice.title}</h2><p>{notice.excerpt}</p><div className="notice-card-foot"><span>{notice.author}</span><button onClick={() => onNavigate(`/notices/${notice.id}`)}>Read full notice <Icon name="arrow" size={15} /></button></div></div>{notice.attachments && <div className="notice-attachments">{notice.attachments.map(file => <AttachmentCard key={file.name} file={file} compact />)}</div>}</article> }
function AttachmentCard({ file, compact = false }: { file: { name: string; type: 'pdf' | 'doc' | 'image'; size: string }; compact?: boolean }) { const icon = file.type === 'pdf' ? 'pdf' : file.type === 'image' ? 'image' : 'file'; return <div className={`attachment-card ${compact ? 'attachment-card--compact' : ''}`}><span className={`file-icon file-icon--${file.type}`}><Icon name={icon} size={18} /></span><div><strong>{file.name}</strong><small>{file.type.toUpperCase()} · {file.size}</small></div><button aria-label={`Download ${file.name}`} onClick={() => alert('Prototype download — this file is a mock attachment.') }><Icon name="download" size={16} /></button></div> }
function NoticesPage({ lang, setLang, onNavigate }: { lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) { const t = translations[lang]; const [query, setQuery] = useState(''); const [category, setCategory] = useState(''); const [visible, setVisible] = useState(3); const filters: string[] = [t.labels.all, t.labels.important, t.labels.general, t.labels.events, t.labels.holidays, t.labels.docs]; const publicNotices = notices.filter(notice => notice.status === 'Published'); const filtered = useMemo(() => publicNotices.filter(notice => { const matchQuery = `${notice.title} ${notice.excerpt} ${notice.category}`.toLowerCase().includes(query.toLowerCase()); const normalized = category === t.labels.all || category === '' ? true : category === t.labels.important ? notice.important : category === t.labels.general ? notice.category === 'General' : category === t.labels.events ? notice.category === 'Events' : category === t.labels.holidays ? notice.category === 'Holidays' : notice.category === 'Documents'; return matchQuery && normalized }), [query, category, t]); return <PublicShell lang={lang} setLang={setLang} onNavigate={onNavigate}><PageIntro eyebrow="Stay in the loop" title="What’s Happening at Little Star?" text="Stay up to date with school announcements, important information, events, and helpful resources for parents." tone="blue" /><main className="section section--feed"><div className="shell"><div className="mock-banner"><Icon name="info" size={17} /><span>{t.labels.mock}. These records are examples for the frontend prototype and are not live school announcements.</span></div><FilterBar value={query || category} setValue={value => { if (filters.includes(value)) { setCategory(value); setQuery('') } else { setQuery(value); setCategory('') } }} categories={filters} placeholder={`${t.labels.search} notices`} />{filtered.length === 0 ? <EmptyState title={t.labels.noResults} text={t.labels.noResultsText} /> : <div className="notice-feed">{filtered.slice(0, visible).map(notice => <NoticeCard key={notice.id} notice={notice} onNavigate={onNavigate} />)}</div>}{visible < filtered.length && <div className="load-more"><Button variant="outline" onClick={() => setVisible(visible + 2)}>Load more notices <Icon name="arrow" size={15} /></Button></div>}</div></main></PublicShell> }
function NoticeDetailPage({ id, lang, setLang, onNavigate }: { id: string; lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) { const notice = notices.find(item => item.id === id && item.status === 'Published'); const [shared, setShared] = useState(false); const share = async () => { if (!notice) return; try { if (navigator.share) await navigator.share({ title: notice.title, text: notice.excerpt, url: window.location.href }); else await navigator.clipboard.writeText(window.location.href); setShared(true) } catch { setShared(false) } }; if (!notice) return <PublicShell lang={lang} setLang={setLang} onNavigate={onNavigate}><main className="detail-page"><div className="shell"><button className="back-link" onClick={() => onNavigate('/notices')}><Icon name="arrow" size={16} /> Back to notices</button><EmptyState title="That notice has moved on" text="We could not find a published notice at this address. Return to the notices shelf to keep exploring." /></div></main></PublicShell>; return <PublicShell lang={lang} setLang={setLang} onNavigate={onNavigate}><main className="detail-page"><div className="shell"><button className="back-link" onClick={() => onNavigate('/notices')}><Icon name="arrow" size={16} /> Back to notices</button><article className="detail-card"><div className="detail-top"><div><div className="notice-tags"><span className="tag tag--blue">{notice.category}</span>{notice.important && <span className="tag tag--important"><Icon name="star" size={12} /> Important</span>}</div><h1>{notice.title}</h1><p className="detail-meta">Published {notice.date} · by {notice.author}</p></div><Button variant="outline" onClick={share}><Icon name="external" size={16} /> {shared ? 'Link copied' : 'Share notice'}</Button></div>{notice.cover && <img className="detail-cover" src={notice.cover} alt="" /> }<div className="detail-layout"><div className="rich-content">{notice.body.map(paragraph => <p key={paragraph}>{paragraph}</p>)}<div className="callout"><Icon name="sparkle" size={19} /><span>This is a development preview record. Live notices will connect to the school’s future publishing system.</span></div></div><aside className="detail-aside"><h3>Attachments</h3>{notice.attachments?.map(file => <AttachmentCard key={file.name} file={file} />)}<Button variant="soft" onClick={() => onNavigate('/documents')}>Browse parent resources <Icon name="arrow" size={15} /></Button></aside></div></article></div></main></PublicShell> }
function FileTypeIcon({ type }: { type: string }) { const icon = type.toLowerCase().includes('pdf') ? 'pdf' : type.toLowerCase().includes('jpg') || type.toLowerCase().includes('png') ? 'image' : 'file'; return <span className={`file-icon file-icon--${type.toLowerCase()}`}><Icon name={icon} size={19} /></span> }
function DocumentCard({ doc, onAction }: { doc: DocRecord; onAction?: (message: string) => void }) { return <article className="document-card"><div className="document-card-top"><FileTypeIcon type={doc.type} /><span className={`status-dot status-dot--${doc.status.toLowerCase()}`}>{doc.status}</span></div><div><span className="document-category">{doc.category}</span><h3>{doc.title}</h3><p>{doc.description}</p></div><div className="document-meta"><span>{doc.type} · {doc.size}</span><span>{doc.date}</span></div><div className="document-actions"><Button variant="soft" onClick={() => onAction?.('Prototype preview opened — the real file will connect in Phase 2.')}>View <Icon name="eye" size={15} /></Button><Button variant="text" onClick={() => onAction?.('Prototype download — mock file only.')}>Download <Icon name="download" size={15} /></Button></div></article> }
function GalleryPage({ lang, setLang, onNavigate }: { lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) { return <PublicShell lang={lang} setLang={setLang} onNavigate={onNavigate}><PageIntro eyebrow="A peek inside" title="Little moments from our happy days." text="Take a gentle look at the curious, creative world inside Little Star Playhouse." tone="coral" /><GalleryPreview /><section className="section section--pale-yellow gallery-page-note"><div className="shell"><div className="section-copy"><SectionLabel tone="yellow">Room to wonder</SectionLabel><h2>Every day has a little <span>story to tell.</span></h2><p>From shared stories and colorful making to building, singing, and movement, our gallery celebrates the small moments that help children feel safe, seen, and ready to explore.</p><Button variant="outline" onClick={() => onNavigate('/contact')}>Ask about a visit <Icon name="arrow" size={15} /></Button></div></div></section></PublicShell> }

function DocumentsPage({ lang, setLang, onNavigate }: { lang: Lang; setLang: (lang: Lang) => void; onNavigate: (path: string) => void }) { const t = translations[lang]; const [query, setQuery] = useState(''); const [category, setCategory] = useState(''); const [typeFilter, setTypeFilter] = useState(''); const [sort, setSort] = useState('newest'); const [toast, setToast] = useState(''); const cats = ['All', 'Forms', 'School Circulars', 'Parent Guidelines', 'Event Documents', 'Learning Resources', 'Other Documents']; const types = ['All file types', 'PDF', 'DOCX', 'JPG']; const filtered = documents.filter(doc => `${doc.title} ${doc.description} ${doc.category} ${doc.type}`.toLowerCase().includes(query.toLowerCase()) && (!category || category === 'All' || doc.category === category) && (!typeFilter || typeFilter === 'All file types' || doc.type === typeFilter)).sort((a, b) => sort === 'type' ? a.type.localeCompare(b.type) : sort === 'oldest' ? new Date(a.date).getTime() - new Date(b.date).getTime() : new Date(b.date).getTime() - new Date(a.date).getTime()); return <PublicShell lang={lang} setLang={setLang} onNavigate={onNavigate}><PageIntro eyebrow="A helpful shelf for families" title="Parent Resources & Uploads" text="Find helpful school documents, forms, circulars, and resources in one convenient place." tone="green" /><main className="section section--feed"><div className="shell"><div className="mock-banner mock-banner--green"><Icon name="info" size={17} /><span>{t.labels.mock}. Sample records are separated from the future document service.</span></div><div className="document-toolbar"><div className="search-field"><Icon name="search" size={18} /><input value={query} onChange={e => setQuery(e.target.value)} placeholder="Search resources" /></div><select value={category} onChange={e => setCategory(e.target.value)} aria-label="Filter documents by category"><option value="">All categories</option>{cats.slice(1).map(cat => <option key={cat}>{cat}</option>)}</select><select value={typeFilter} onChange={e => setTypeFilter(e.target.value)} aria-label="Filter documents by file type">{types.map(type => <option key={type} value={type === 'All file types' ? '' : type}>{type}</option>)}</select><select value={sort} onChange={e => setSort(e.target.value)} aria-label="Sort documents"><option value="newest">{t.labels.newest}</option><option value="oldest">Oldest first</option><option value="type">File type</option></select></div><div className="category-row">{cats.map(cat => <button key={cat} className={(category === cat || (!category && cat === 'All')) ? 'is-selected' : ''} onClick={() => setCategory(cat === 'All' ? '' : cat)}>{cat}</button>)}</div>{filtered.length === 0 ? <EmptyState title="No resources found" text="Try another category, file type, or keyword and we will look again." /> : <div className="document-grid">{filtered.map(doc => <DocumentCard key={doc.id} doc={doc} onAction={setToast} />)}</div>}</div></main>{toast && <Toast message={toast} onClose={() => setToast('')} />}</PublicShell> }
function EmptyState({ title, text }: { title: string; text: string }) { return <div className="empty-state"><span><Icon name="star" size={29} /></span><h3>{title}</h3><p>{text}</p></div> }

function AdminSidebar({ current, onNavigate, open, setOpen }: { current: string; onNavigate: (path: string) => void; open: boolean; setOpen: (open: boolean) => void }) { const items = [{ path: '/admin', label: 'Overview', icon: 'dashboard' }, { path: '/admin/notices', label: 'Notices', icon: 'notice' }, { path: '/admin/notices/new', label: 'Create Notice', icon: 'plus' }, { path: '/admin/documents', label: 'Uploads', icon: 'upload' }, { path: '/admin/settings', label: 'Settings', icon: 'settings' }]; return <aside className={`admin-sidebar ${open ? 'is-open' : ''}`}><div className="admin-sidebar-head"><button onClick={() => onNavigate('/')}><Logo compact /></button><button className="admin-close" aria-label="Close admin menu" onClick={() => setOpen(false)}><Icon name="close" size={18} /></button></div><div className="admin-sidebar-label">Little Star admin <span>Preview</span></div><nav>{items.map(item => <button key={item.path} className={current === item.path ? 'is-active' : ''} onClick={() => { onNavigate(item.path); setOpen(false) }}><Icon name={item.icon} size={18} />{item.label}</button>)}</nav><div className="admin-sidebar-bottom"><div className="admin-user"><span>LS</span><div><strong>Playhouse team</strong><small>Frontend preview</small></div></div><button onClick={() => onNavigate('/')}><Icon name="logout" size={17} />Exit admin preview</button></div></aside> }
function AdminTopbar({ onOpen, onNavigate }: { onOpen: () => void; onNavigate: (path: string) => void }) { return <div className="admin-topbar"><button className="admin-menu" aria-label="Open admin menu" onClick={onOpen}><Icon name="menu" size={21} /></button><div><span className="admin-breadcrumb">Little Star Playhouse /</span><strong>Frontend workspace</strong></div><div className="admin-top-actions"><span className="preview-pill"><i /> Prototype mode</span><button className="icon-button" aria-label="Notifications"><Icon name="bell" size={19} /></button><button className="admin-avatar" onClick={() => onNavigate('/admin/settings')}>LS</button></div></div> }
function AdminLayout({ path, children, onNavigate }: { path: string; children: ReactNode; onNavigate: (path: string) => void }) { const [open, setOpen] = useState(false); return <div className="admin-shell"><AdminSidebar current={path} onNavigate={onNavigate} open={open} setOpen={setOpen} /><div className="admin-main"><AdminTopbar onOpen={() => setOpen(true)} onNavigate={onNavigate} /><div className="admin-content">{children}</div></div></div> }
function AdminHeader({ eyebrow, title, text, action }: { eyebrow: string; title: string; text: string; action?: ReactNode }) { return <div className="admin-page-head"><div><span className="admin-eyebrow">{eyebrow}</span><h1>{title}</h1><p>{text}</p></div>{action}</div> }
function MetricCard({ label, value, note, icon, color }: { label: string; value: string; note: string; icon: string; color: string }) { return <div className={`metric-card metric-card--${color}`}><div className="metric-icon"><Icon name={icon} size={19} /></div><span>{label}</span><strong>{value}</strong><small>{note}</small></div> }
function AdminOverview({ onNavigate, toast }: { onNavigate: (path: string) => void; toast: (message: string) => void }) { return <><AdminHeader eyebrow="Good morning, Playhouse team" title="A little overview." text="Keep an eye on your parent-facing content from one calm workspace." action={<Button onClick={() => onNavigate('/admin/notices/new')}><Icon name="plus" size={16} /> Create notice</Button>} /><div className="preview-notice"><Icon name="info" size={16} /><span><strong>Preview data only.</strong> These numbers and actions demonstrate the interface and reset when this prototype refreshes.</span></div><div className="metric-grid"><MetricCard label="Published notices" value="12" note="Preview records" icon="notice" color="blue" /><MetricCard label="Draft notices" value="04" note="Needs a little polish" icon="edit" color="yellow" /><MetricCard label="Scheduled notices" value="03" note="Prototype timeline" icon="calendar" color="green" /><MetricCard label="Published documents" value="18" note="Resource shelf" icon="file" color="coral" /></div><div className="admin-two-col"><section className="admin-panel"><div className="panel-head"><div><span className="admin-eyebrow">Keep the story moving</span><h2>Recent notices</h2></div><button onClick={() => onNavigate('/admin/notices')}>View all <Icon name="arrow" size={14} /></button></div><div className="recent-list">{notices.slice(0, 3).map(notice => <button key={notice.id} onClick={() => onNavigate('/admin/notices')}><span className={`recent-icon recent-icon--${notice.category.toLowerCase()}`}><Icon name={notice.category === 'Events' ? 'calendar' : 'notice'} size={17} /></span><span><strong>{notice.title}</strong><small>{notice.category} · {notice.date}</small></span><Icon name="chevron" size={16} /></button>)}</div></section><section className="admin-panel quick-panel"><div className="panel-head"><div><span className="admin-eyebrow">Small next steps</span><h2>Quick actions</h2></div></div><div className="quick-grid"><button onClick={() => onNavigate('/admin/notices/new')}><span><Icon name="plus" size={19} /></span><strong>Create notice</strong><small>Share an update</small></button><button onClick={() => onNavigate('/admin/documents')}><span><Icon name="upload" size={19} /></span><strong>Upload document</strong><small>Add to parent shelf</small></button><button onClick={() => toast('Preview settings opened — no changes are saved yet.')}><span><Icon name="settings" size={19} /></span><strong>Review settings</strong><small>Check school details</small></button><button onClick={() => onNavigate('/')}><span><Icon name="eye" size={19} /></span><strong>View public site</strong><small>See the story</small></button></div></section></div></> }
function AdminNotices({ onNavigate, toast }: { onNavigate: (path: string) => void; toast: (message: string) => void }) { const [query, setQuery] = useState(''); const [status, setStatus] = useState('All statuses'); const [visible, setVisible] = useState(3); const [rows, setRows] = useState(notices); const filtered = rows.filter(item => `${item.title} ${item.category}`.toLowerCase().includes(query.toLowerCase()) && (status === 'All statuses' || item.status === status)); return <><AdminHeader eyebrow="Content library" title="Notices" text="Shape the small updates families rely on, with a clear view of each draft and publication state." action={<Button onClick={() => onNavigate('/admin/notices/new')}><Icon name="plus" size={16} /> Create notice</Button>} /><div className="admin-toolbar"><div className="search-field"><Icon name="search" size={17} /><input value={query} onChange={e => setQuery(e.target.value)} placeholder="Search notices" /></div><select value={status} onChange={e => setStatus(e.target.value)}><option>All statuses</option><option>Published</option><option>Draft</option><option>Scheduled</option></select><Button variant="outline" onClick={() => toast('Filters are ready for the future notice service.') }><Icon name="filter" size={16} /> More filters</Button></div><section className="admin-panel table-panel"><div className="table-note"><Icon name="info" size={15} /> Changes here are temporary and will not persist after refreshing the prototype.</div><div className="responsive-table"><div className="table-row table-row--head"><span>Notice</span><span>Category</span><span>Status</span><span>Created</span><span>Actions</span></div>{filtered.slice(0, visible).map(item => <div className="table-row" key={item.id}><span className="table-title"><span className="table-icon"><Icon name="notice" size={16} /></span><strong>{item.title}</strong>{item.pinned && <Icon name="pin" size={14} />}</span><span><span className="table-category">{item.category}</span></span><span><span className={`table-status table-status--${item.status.toLowerCase()}`}>{item.status}</span></span><span className="table-muted">{item.date}</span><span className="table-actions"><button aria-label="Preview" onClick={() => onNavigate(`/notices/${item.id}`)}><Icon name="eye" size={16} /></button><button aria-label="Edit" onClick={() => toast('Edit mode is represented in this preview.')}><Icon name="edit" size={16} /></button><button aria-label={item.status === 'Published' ? 'Unpublish' : 'Publish'} onClick={() => { setRows(rows.map(row => row.id === item.id ? { ...row, status: row.status === 'Published' ? 'Draft' : 'Published' } : row)); toast(`${item.status === 'Published' ? 'Unpublish' : 'Publish'} changed in prototype state only.`) }}><Icon name="check" size={16} /></button><button aria-label="Delete" onClick={() => { if (window.confirm('Remove this mock notice from the preview?')) { setRows(rows.filter(row => row.id !== item.id)); toast('Mock notice removed from this preview.') } }}><Icon name="trash" size={16} /></button></span></div>)}</div>{filtered.length === 0 && <EmptyState title="No notices match" text="Try a different search or status." />}{visible < filtered.length && <div className="load-more"><Button variant="outline" onClick={() => setVisible(visible + 3)}>Load more <Icon name="arrow" size={15} /></Button></div>}</section></> }

function UploadDropzone({ accept, files, setFiles, label, note }: { accept: string; files: File[]; setFiles: (files: File[]) => void; label: string; note: string }) { const [error, setError] = useState(''); const addFiles = (incoming: FileList | null) => { if (!incoming) return; const candidates = Array.from(incoming); const valid = candidates.filter(file => { const extension = file.name.toLowerCase().slice(file.name.lastIndexOf('.')); const typeAllowed = (accept.includes('image') && file.type.startsWith('image/')) || ['.pdf', '.doc', '.docx'].some(item => accept.includes(item) && extension === item); return typeAllowed && file.size <= 10 * 1024 * 1024 }); const invalidCount = candidates.length - valid.length; setError(invalidCount ? `${invalidCount} file${invalidCount > 1 ? 's were' : ' was'} skipped. Use the listed file types under 10 MB.` : ''); if (valid.length) setFiles([...files, ...valid]); }; const drop = (event: DragEvent<HTMLDivElement>) => { event.preventDefault(); addFiles(event.dataTransfer.files) }; const imageFiles = files.filter(file => file.type.startsWith('image/')); return <div className="dropzone" onDragOver={e => e.preventDefault()} onDrop={drop}><input id={`file-${label}`} type="file" accept={accept} multiple onChange={e => addFiles(e.target.files)} /><label htmlFor={`file-${label}`}><span className="dropzone-icon"><Icon name="upload" size={22} /></span><strong>{label}</strong><small>{note}</small><Button variant="soft">Choose files</Button></label>{error && <div className="upload-error" role="alert"><Icon name="info" size={14} />{error}</div>}{imageFiles.length > 0 && <div className="upload-preview" aria-label="Selected image previews">{imageFiles.map((file, index) => <img key={`${file.name}-preview-${index}`} src={URL.createObjectURL(file)} alt={`Preview of ${file.name}`} />)}</div>}{files.length > 0 && <div className="upload-list">{files.map((file, index) => <div className="upload-file" key={`${file.name}-${index}`}><FileTypeIcon type={file.type || file.name} /><div><strong>{file.name}</strong><small>{(file.size / 1024).toFixed(0)} KB · local preview</small></div><span className="upload-progress"><i /></span><button onClick={() => setFiles(files.filter((_, fileIndex) => fileIndex !== index))} aria-label={`Remove ${file.name}`}><Icon name="close" size={16} /></button></div>)}</div>}</div> }
function RichTextToolbar({ onLink }: { onLink: () => void }) { const run = (command: string, value?: string) => { document.execCommand(command, false, value); document.querySelector<HTMLElement>('[contenteditable="true"]')?.focus() }; const buttons = [{ icon: 'bold', command: 'bold', label: 'Bold' }, { icon: 'italic', command: 'italic', label: 'Italic' }, { icon: 'underline', command: 'underline', label: 'Underline' }, { icon: 'heading', command: 'formatBlock', value: 'h3', label: 'Heading' }, { icon: 'list', command: 'insertUnorderedList', label: 'Bullet list' }, { icon: 'list', command: 'insertOrderedList', label: 'Numbered list' }, { icon: 'link', command: 'link', label: 'Insert link' }, { icon: 'undo', command: 'undo', label: 'Undo' }, { icon: 'redo', command: 'redo', label: 'Redo' }]; return <div className="rich-toolbar">{buttons.map(button => <button key={button.label} type="button" title={button.label} aria-label={button.label} onClick={() => button.command === 'link' ? onLink() : run(button.command, button.value)}><Icon name={button.icon} size={16} /></button>)}<span /><button type="button" title="Clear formatting" onClick={() => run('removeFormat')}><Icon name="close" size={15} /></button></div> }
function NoticeComposer({ onNavigate, toast }: { onNavigate: (path: string) => void; toast: (message: string) => void }) { const [files, setFiles] = useState<File[]>([]); const [docs, setDocs] = useState<File[]>([]); const [linkOpen, setLinkOpen] = useState(false); const [link, setLink] = useState(''); const [title, setTitle] = useState(''); const save = (label: string) => { if (!title.trim()) { toast('Add a notice title before saving the prototype.'); return } toast(`${label} saved in prototype state only — it will reset after refresh.`) }; return <><AdminHeader eyebrow="Create something helpful" title="Write a new notice." text="A calm composer for the updates, invitations, and little reminders families need." action={<Button variant="outline" onClick={() => onNavigate('/admin/notices')}><Icon name="arrow" size={15} /> Back to notices</Button>} /><div className="composer-grid"><section className="admin-panel composer-main"><div className="field-group"><label htmlFor="notice-title">Notice title</label><input id="notice-title" value={title} onChange={e => setTitle(e.target.value)} placeholder="Give this update a clear, kind title" /></div><div className="field-grid"><label>Category<select><option>General Announcements</option><option>Important</option><option>Events</option><option>Holidays</option><option>Documents</option></select></label><label>External link <input placeholder="Optional URL" /></label></div><div className="editor-field"><div className="editor-label"><label>Notice content</label><span>Rich text</span></div><RichTextToolbar onLink={() => setLinkOpen(true)} /><div className="rich-editor" contentEditable suppressContentEditableWarning role="textbox" aria-label="Notice content editor"><h3>A little note for our families</h3><p>Start writing the heart of your announcement here. Keep the first few lines helpful and easy to scan.</p></div></div><div className="attachment-columns"><div><div className="editor-label"><label>Image attachments</label><span>{files.length} selected</span></div><UploadDropzone accept="image/*" files={files} setFiles={setFiles} label="Drop images here" note="JPG, PNG up to 10 MB each" /></div><div><div className="editor-label"><label>Document attachments</label><span>{docs.length} selected</span></div><UploadDropzone accept=".pdf,.doc,.docx" files={docs} setFiles={setDocs} label="Drop documents here" note="PDF, DOC, DOCX up to 10 MB each" /></div></div></section><aside className="composer-side"><section className="admin-panel settings-panel"><div className="panel-head"><div><span className="admin-eyebrow">Publication settings</span><h2>Make it ready</h2></div></div><label>Status<select><option>Draft</option><option>Published</option><option>Scheduled</option></select></label><label>Schedule date and time<input type="datetime-local" /></label><label>Expiry date<input type="date" /></label><label>Cover image<select><option>No cover selected</option><option>Use first image attachment</option></select></label><label className="toggle-line"><input type="checkbox" /><span className="toggle" />Pin as important</label><div className="settings-divider" /><div className="editor-actions"><Button onClick={() => save('Draft')}>Save draft</Button><Button variant="outline" onClick={() => save('Preview')}>Preview</Button><Button variant="soft" onClick={() => save('Publish')}>Publish notice <Icon name="arrow" size={15} /></Button><Button variant="text" onClick={() => save('Schedule')}>Schedule for later</Button></div><small className="prototype-note"><Icon name="info" size={14} /> Prototype only. No notice is actually published or scheduled.</small></section></aside></div>{linkOpen && <div className="modal-backdrop" role="presentation"><div className="modal-card" role="dialog" aria-modal="true"><button className="modal-close" onClick={() => setLinkOpen(false)}><Icon name="close" size={17} /></button><span className="modal-icon"><Icon name="link" size={20} /></span><h2>Insert a helpful link</h2><p>Prototype link dialog — choose a URL for the selected text.</p><label>URL<input value={link} onChange={e => setLink(e.target.value)} placeholder="https://" autoFocus /></label><div className="modal-actions"><Button variant="outline" onClick={() => setLinkOpen(false)}>Cancel</Button><Button onClick={() => { document.execCommand('createLink', false, link); setLinkOpen(false); toast('Link added to the local editor preview.') }}>Insert link</Button></div></div></div>}</> }
function AdminDocuments({ toast }: { toast: (message: string) => void }) { const [files, setFiles] = useState<File[]>([]); const [rows, setRows] = useState(documents); return <><AdminHeader eyebrow="Parent resource shelf" title="Uploads & resources" text="Prepare helpful forms and resources for the public library. Everything here is a frontend preview." action={<Button onClick={() => document.getElementById('file-Upload a document')?.click()}><Icon name="upload" size={16} /> Upload document</Button>} /><div className="upload-layout"><section className="admin-panel upload-form"><div className="panel-head"><div><span className="admin-eyebrow">New document</span><h2>Add a resource</h2></div></div><div className="field-group"><label>Document title<input placeholder="For example, Parent Welcome Guide" /></label></div><div className="field-group"><label>Description<textarea rows={3} placeholder="Help families understand what this resource is for." /></label></div><div className="field-grid"><label>Category<select><option>Forms</option><option>School Circulars</option><option>Parent Guidelines</option><option>Event Documents</option><option>Learning Resources</option><option>Other Documents</option></select></label><label>Publication status<select><option>Draft</option><option>Published</option></select></label></div><UploadDropzone accept=".pdf,.doc,.docx,image/*" files={files} setFiles={setFiles} label="Upload a document" note="Drag and drop or browse · PDF, DOCX, JPG" /><div className="editor-actions"><Button onClick={() => toast(files.length ? 'Document saved to prototype state — it is not permanently uploaded.' : 'Choose a file before saving this prototype document.')}>Save draft</Button><Button variant="soft" onClick={() => toast('Publish preview complete — no permanent upload occurred.')}>Publish document <Icon name="arrow" size={15} /></Button><Button variant="text" onClick={() => setFiles([])}>Cancel</Button></div><small className="prototype-note"><Icon name="info" size={14} /> {translations.en.labels.localOnly}</small></section><section className="admin-panel"><div className="panel-head"><div><span className="admin-eyebrow">Current library</span><h2>Resource records</h2></div><span className="panel-count">{rows.length} preview items</span></div><div className="resource-admin-list">{rows.slice(0, 4).map(doc => <div key={doc.id} className="resource-admin-row"><FileTypeIcon type={doc.type} /><div><strong>{doc.title}</strong><small>{doc.category} · {doc.size}</small></div><span className={`table-status table-status--${doc.status.toLowerCase()}`}>{doc.status}</span><div className="table-actions"><button aria-label="Preview document" onClick={() => toast('Document preview opened.') }><Icon name="eye" size={16} /></button><button aria-label="Edit document" onClick={() => toast('Edit details are shown as a prototype action.') }><Icon name="edit" size={16} /></button><button aria-label="Download document" onClick={() => toast('Prototype download — mock file only.') }><Icon name="download" size={16} /></button><button aria-label={doc.status === 'Published' ? 'Unpublish document' : 'Publish document'} onClick={() => { setRows(rows.map(row => row.id === doc.id ? { ...row, status: row.status === 'Published' ? 'Draft' : 'Published' } : row)); toast('Document status changed in prototype state only.') }}><Icon name="check" size={16} /></button><button aria-label="Delete document" onClick={() => { if (window.confirm('Remove this mock document from the preview?')) { setRows(rows.filter(row => row.id !== doc.id)); toast('Mock document removed.') } }}><Icon name="trash" size={16} /></button></div></div>)}</div></section></div></> }
function AdminSimple({ title, eyebrow, text, icon, toast }: { title: string; eyebrow: string; text: string; icon: string; toast: (message: string) => void }) { return <><AdminHeader eyebrow={eyebrow} title={title} text={text} /><div className="admin-empty-hero"><span><Icon name={icon} size={31} /></span><h2>A clear little corner for the next phase.</h2><p>This screen is intentionally prepared as a frontend surface. Connect it to real services in Phase 2 without changing the surrounding admin shell.</p><Button variant="outline" onClick={() => toast('Prototype settings are ready for future integration.')}>Explore preview state <Icon name="arrow" size={15} /></Button></div></> }
function AdminPage({ path, onNavigate }: { path: string; onNavigate: (path: string) => void }) { const [toastText, setToast] = useState(''); const toast = (message: string) => setToast(message); let content: ReactNode; if (path === '/admin') content = <AdminOverview onNavigate={onNavigate} toast={toast} />; else if (path === '/admin/notices') content = <AdminNotices onNavigate={onNavigate} toast={toast} />; else if (path === '/admin/notices/new') content = <NoticeComposer onNavigate={onNavigate} toast={toast} />; else if (path === '/admin/documents') content = <AdminDocuments toast={toast} />; else if (path === '/admin/uploads') content = <AdminSimple eyebrow="File workspace" title="Uploads" text="Review the local file previews prepared for future storage integration." icon="upload" toast={toast} />; else content = <AdminSimple eyebrow="School workspace" title="Settings" text="Keep the school’s public details, language defaults, and future publishing preferences in one place." icon="settings" toast={toast} />; return <AdminLayout path={path} onNavigate={onNavigate}>{content}{toastText && <Toast message={toastText} onClose={() => setToast('')} />}</AdminLayout> }

export default function App() { const [path, setPath] = useState(window.location.pathname || '/'); const [lang, setLang] = useState<Lang>('en'); useEffect(() => { const onPop = () => setPath(window.location.pathname); window.addEventListener('popstate', onPop); return () => window.removeEventListener('popstate', onPop) }, []); const navigate = (nextPath: string) => { const target = nextPath.startsWith('/') ? nextPath : `/${nextPath}`; window.history.pushState({}, '', target); setPath(target); window.scrollTo({ top: 0, behavior: 'smooth' }) }; if (path.startsWith('/admin')) return <AdminPage path={path} onNavigate={navigate} />; if (path.startsWith('/notices/')) return <NoticeDetailPage id={path.split('/')[2]} lang={lang} setLang={setLang} onNavigate={navigate} />; if (path === '/notices') return <NoticesPage lang={lang} setLang={setLang} onNavigate={navigate} />; if (path === '/documents') return <DocumentsPage lang={lang} setLang={setLang} onNavigate={navigate} />; if (path === '/about') return <AboutPage lang={lang} setLang={setLang} onNavigate={navigate} />; if (path === '/programs') return <ProgramsPage lang={lang} setLang={setLang} onNavigate={navigate} />; if (path === '/our-little-world') return <WorldPage lang={lang} setLang={setLang} onNavigate={navigate} />; if (path === '/gallery') return <GalleryPage lang={lang} setLang={setLang} onNavigate={navigate} />; if (path === '/contact') return <ContactPage lang={lang} setLang={setLang} onNavigate={navigate} />; return <HomePage lang={lang} setLang={setLang} onNavigate={navigate} /> }
