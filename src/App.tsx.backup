import { useEffect, useMemo, useState, type ChangeEvent, type DragEvent, type ReactNode } from 'react'
import { activities, documents, faq, notices, programs, translations, type Category, type DocRecord, type Lang, type Notice } from './data'

const HERO_ART = '/assets/hero-full.webp'
const GALLERY_ART = '/assets/gallery-classroom.webp'
const MAPS_URL = 'https://maps.app.goo.gl/1PW44EVbxNpbGBfC8'

