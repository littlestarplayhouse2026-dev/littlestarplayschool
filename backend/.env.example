# Use the Supabase direct/session-pooler PostgreSQL URL from the project dashboard.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ENVIRONMENT=production
PORT=8000
FRONTEND_ORIGINS=https://your-domain.example
STORAGE_BACKEND=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-private-service-role-key
SUPABASE_STORAGE_BUCKET=playhouse-uploads
# Used only when STORAGE_BACKEND=local; production local storage needs a durable mounted volume.
UPLOAD_DIR=/var/lib/playhouse/uploads
UPLOAD_STORAGE_PERSISTENT=false
MAX_UPLOAD_MB=10
MAX_REQUEST_MB=50
